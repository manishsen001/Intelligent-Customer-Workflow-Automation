# AI Workflow Automation System - Environment Variables
# Copy this file to .env and fill in your values

# LLM Provider Configuration (choose one)
# Supported: "nvidia", "openai"
LLM_PROVIDER=nvidia

# NVIDIA API Configuration (for Nemotron 3 Ultra via NVIDIA hosted API)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# OpenAI API Configuration (legacy - kept for compatibility)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# Email Configuration (for email automation)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Database (optional - for persistence)
DATABASE_URL=sqlite:///workflow.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost